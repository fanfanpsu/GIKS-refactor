{
  "name": "giks-sort",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@primer/octicons-react": "^9.3.1",
    "autoprefixer": "7.1.2",
    "axios": "^0.21.4",
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.5.1",
    "babel-loader": "^8.3.0",
    "babel-preset-react-app": "^10.0.1",
    "bootstrap": "^4.6.2",
    "case-sensitive-paths-webpack-plugin": "2.1.1",
    "chalk": "1.1.3",
    "classnames": "^2.2.6",
    "css-loader": "^3.6.0",
    "cytoscape": "^3.30.0",
    "dotenv": "4.0.0",
    "eslint": "^7.32.0",
    "eslint-config-react-app": "^6.0.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-flowtype": "^5.10.0",
    "eslint-plugin-import": "^2.27.0",
    "eslint-plugin-jsx-a11y": "^6.7.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "mini-css-extract-plugin": "^1.6.2",
    "file-loader": "^6.2.0",
    "firebase": "^8.10.0",
    "fs-extra": "3.0.1",
    "html-webpack-plugin": "^4.5.2",
    "jest": "^27.5.1",
    "jquery": "^3.7.1",
    "kruskal": "0.0.5",
    "object-assign": "4.1.1",

    "postcss-flexbugs-fixes": "3.2.0",
    "postcss-loader": "2.0.6",
    "promise": "8.0.1",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-bootstrap": "^1.0.0-beta.16",
    "react-dev-utils": "^9.1.0",
    "react-dom": "^17.0.2",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "react-table": "^6.11.0",
    "react-transition-group": "^2.3.0-beta.0",
    "reactstrap": "^7.1.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "style-loader": "^1.3.0",
    "sw-precache-webpack-plugin": "0.11.4",
    "url-loader": "^4.1.1",
    "vis-react": "0.4.3",
    "webpack": "^4.47.0",
    "webpack-dev-server": "^3.11.3",
    "webpack-manifest-plugin": "^2.2.0",
    "whatwg-fetch": "2.0.3"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider node scripts/start.js",
    "build": "NODE_OPTIONS=--openssl-legacy-provider node scripts/build.js",
    "test": "NODE_OPTIONS=--openssl-legacy-provider node scripts/test.js --env=jsdom"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}"
    ],
    "setupFiles": [
      "<rootDir>/config/polyfills.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.js?(x)",
      "<rootDir>/src/**/?(*.)(spec|test).js?(x)"
    ],
    "testEnvironment": "node",
    "testURL": "http://localhost",
    "transform": {
      "^.+\\.(js|jsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "devDependencies": {
    "terser-webpack-plugin": "^4.2.3"
  }
}
